{
  "ConnectionStrings": {
    "TrainingDatabase": "Host=localhost;Port=5432;Database=powerlifting_program;Username=powerlifting;Password=powerlifting"
  },
  "Database": {
    "Provider": "Postgres",
    "InMemoryName": "powerlifting-program-development",
    "SeedSampleDataOnStartup": false,
    "ApplyMigrationsOnStartup": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:8081",
      "http://localhost:19006"
    ]
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "PowerliftingProgram.Api",
      "Audience": "PowerliftingProgram.Client",
      "SigningKey": "development-only-replace-with-a-64-byte-minimum-signing-key-2026-iron-forge",
      "ExpiresInHours": 12
    }
  },
  "Client": {
    "RegistrationUrl": "http://localhost:8081/register"
  },
  "Email": {
    "Resend": {
      "From": "Iron Forge <invites@example.com>"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
