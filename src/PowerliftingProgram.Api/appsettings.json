{
  "Database": {
    "Provider": "Postgres",
    "InMemoryName": "powerlifting-program-development",
    "SeedSampleDataOnStartup": false,
    "ApplyMigrationsOnStartup": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:8081",
      "http://localhost:19006"
    ]
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "PowerliftingProgram.Api",
      "Audience": "PowerliftingProgram.Client",
      "ExpiresInHours": 12
    }
  },
  "Client": {
    "RegistrationUrl": "http://localhost:8081/register",
    "InvitationUrl": "http://localhost:8081/invitation",
    "PasswordResetUrl": "http://localhost:8081/reset-password"
  },
  "Email": {
    "Resend": {
      "From": "Iron Forge <notifications@ironforge.app>"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
