# Azure Developer CLI Environment Variables Template
# Copy this file to .azure/<environment-name>/.env and fill in the values

# Azure Configuration
AZURE_ENV_NAME=
AZURE_LOCATION=eastus2
AZURE_SUBSCRIPTION_ID=

# Principal for ACR role assignments (your Azure AD user/service principal ID)
AZURE_PRINCIPAL_ID=
# Use User for local deployment or ServicePrincipal for GitHub OIDC.
AZURE_PRINCIPAL_TYPE=User

# Frontend Configuration (Required)
# Origin only for CORS, with no path: https://YOUR_USERNAME.github.io
FRONTEND_ORIGIN=
# Full project URL for email links: https://YOUR_USERNAME.github.io/PowerliftingLogs
FRONTEND_BASE_URL=

# Database Configuration (Required)
# External PostgreSQL connection string (Neon, Azure PostgreSQL, etc.)
# Example: Host=xxx.postgres.database.azure.com;Port=5432;Database=powerlifting;Username=xxx;Password=xxx;SslMode=Require
DATABASE_CONNECTION_STRING=

# JWT Configuration (Required)
# Generate with the PowerShell command in DEPLOYMENT.md.
# The configured text must be at least 64 UTF-8 bytes.
JWT_SIGNING_KEY=

# Email Configuration (Required)
# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender email (cannot use github.io domain)
# Must be verified in your Resend account
VERIFIED_SENDER_EMAIL=

