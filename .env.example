# API runtime
ConnectionStrings__TrainingDatabase=Host=localhost;Port=5432;Database=powerlifting_program;Username=powerlifting;Password=powerlifting
Database__Provider=Postgres
Database__ApplyMigrationsOnStartup=false
Database__SeedSampleDataOnStartup=false
Cors__AllowedOrigins__0=http://localhost:8081
Authentication__Jwt__SigningKey=replace-with-a-random-secret-at-least-32-characters-long
Authentication__Jwt__Issuer=PowerliftingProgram.Api
Authentication__Jwt__Audience=PowerliftingProgram.Client
Client__RegistrationUrl=http://localhost:8081/register
Email__Resend__ApiKey=
Email__Resend__From=Iron Forge <invites@example.com>

# Expo runtime: leave static demo false when targeting a live API.
EXPO_PUBLIC_API_URL=http://localhost:5080
EXPO_PUBLIC_STATIC_DEMO=false
